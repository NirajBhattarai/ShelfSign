# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (auth + direct profile reads/writes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# x402 — real Hedera testnet pay (buyer wallet or local payer key)
# Same agent/payer as backend HEDERA_AGENT_* after `npm run setup:hedera`
NEXT_PUBLIC_HEDERA_PAYER_ID=
NEXT_PUBLIC_HEDERA_PAYER_KEY=
NEXT_PUBLIC_HEDERA_NETWORK=testnet
# Only set for offline unit tests — leave unset for real settle:
# NEXT_PUBLIC_X402_MOCK=1

# WalletConnect / HashPack (Reown Cloud project id)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=7f8dfa6d6098111cb211298498b8f2c2

# Chain explorer links (Hedera HashScan, etc.)
NEXT_PUBLIC_EXPLORER_BASE_URL=
