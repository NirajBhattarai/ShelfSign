# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (auth + direct profile reads/writes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# x402 — buyer pays from the browser with this Hedera testnet account
# (same agent/payer created by backend `npm run setup:hedera`; do not commit real keys)
NEXT_PUBLIC_HEDERA_PAYER_ID=
NEXT_PUBLIC_HEDERA_PAYER_KEY=
NEXT_PUBLIC_HEDERA_NETWORK=testnet
# Force mock PAYMENT-SIGNATURE (local only; leave unset for real settle)
# NEXT_PUBLIC_X402_MOCK=1

# WalletConnect / HashPack (free project id: https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Chain explorer links (Hedera HashScan, etc.)
NEXT_PUBLIC_EXPLORER_BASE_URL=
