PORT=4000

# Supabase (accounts, camera registry, attestations, buy orders)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hedera (HCS attestation log + x402 payTo)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_HCS_TOPIC_ID=

# Agent wallet that pays for x402 stock queries (buyer agent / demo payer)
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=

# Allow attestation to succeed when detection works but PUF key regeneration
# fails (e.g. demo hardware, IRCUT not settled). NEVER enable in production.
# SHELFSIGN_ALLOW_PUF_SOFTFAIL=1

# Treat a classical PRNU correlation mismatch (vision-service/src/cmos/prnu.py)
# as fraud grounds. Off by default until PRNU_MATCH_THRESHOLD is calibrated
# against real enrolled hardware — until then the score is recorded
# (attestations.prnu_score) but doesn't gate verification. Set the same flag
# in vision-service's .env too (it also gates /cmos/challenge's own `match`).
# SHELFSIGN_ENFORCE_PRNU=1

# x402 — Hedera testnet settle via Blocky402 (no mock)
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_PAY_TO=
# 0.0.0 = HBAR. Or HTS USDC token id (6 decimals), e.g. Circle testnet 0.0.429274
X402_ASSET=0.0.0
X402_PRICE_PER_QUERY_USDC=0.01

# Optional: portal PAT for programmatic faucet
# Portal PAT → auto-fund testnet via `npm run setup:hcs` (portal.hedera.com → PAT)
# HEDERA_PAT=

# After generating ECDSA keys + faucet:
#   HEDERA_OPERATOR_KEY=0x… HEDERA_OPERATOR_EVM=0x… \
#   HEDERA_AGENT_KEY=0x… HEDERA_AGENT_EVM=0x… \
#   npm run setup:hedera
# Then: ONCHAIN=1 npm run test:onchain

# Chainlink CRE confidential fraud review (Vault DON secret = Bearer for /cre/internal/*)
CRE_API_TOKEN=
CRE_SLASH_THRESHOLD=700
CRE_HOLD_THRESHOLD=350

# Hedera HBAR escrow vault — MANDATORY camera fraud bond (default 10 ℏ).
# Easy to fund from https://faucet.hedera.com. POST /cameras refuses to enroll
# (503 escrow_not_configured) unless the vault is set, and fails enrollment
# (502 escrow_lock_failed) if the lock transfer fails. A CRE SLASH verdict
# forfeits it; supplier restakes via POST /cameras/:id/restake.
# Create with: npm run setup:escrow
HEDERA_ESCROW_ACCOUNT_ID=
ESCROW_TOKEN_ID=0.0.0
ESCROW_AMOUNT_HBAR=10
# Optional funder (defaults to HEDERA_AGENT_ID/KEY)
# ESCROW_FUNDER_ID=
# ESCROW_FUNDER_KEY=

# Vision service (Python) internal URL — also stored in system_settings via
# `npm run seed:camera-settings` so the backend reads it from the DB.
VISION_SERVICE_URL=http://localhost:8000

# Public URL of this backend (used to build buyer/supplier live stream links
# stored in system_settings — frontend never hardcodes the API host).
PUBLIC_API_URL=http://localhost:4000

# Default Hikvision camera (SiliconWitness). Seed into system_settings with
# `npm run seed:camera-settings`. Frontend never sees these values.
HIKVISION_HOST=
HIKVISION_USER=
HIKVISION_PASS=
