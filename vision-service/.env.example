PORT=8000

# YOLO model
VISION_MODEL_PATH=models/yolov8n-stock-v1.pt

# CMOS/PRNU enrollment store
CMOS_TEMPLATE_STORE_PATH=data/cmos_templates

# Classical PRNU sensor-noise correlation (src/cmos/prnu.py). Threshold is a
# literature-typical starting point, not calibrated against real hardware —
# leave enforcement off (backend's SHELFSIGN_ENFORCE_PRNU) until you've
# checked genuine-vs-impostor score separation on the actual enrolled camera.
# PRNU_MATCH_THRESHOLD=0.01
# SHELFSIGN_ENFORCE_PRNU=1
