PORT=8000

# YOLO (src/vision/detect.py)
YOLO_MODEL_NAME=yolov8n-stock-v1
YOLO_WEIGHTS=yolov8n.pt
# YOLO_CONFIDENCE=0.25
# YOLO_SKU_MAP_PATH=
# YOLO_SKU_MAP_JSON=

# CMOS/PUF enrollment store (src/cmos/fingerprint.py)
CMOS_ENROLLMENTS_DIR=data/enrollments

# Classical PRNU sensor-noise correlation (src/cmos/prnu.py). Threshold is a
# literature-typical starting point, not calibrated against real hardware —
# leave enforcement off until you've checked genuine-vs-impostor scores on
# the enrolled camera. Set on both vision-service and backend to hard-gate.
# PRNU_MATCH_THRESHOLD=0.01
# SHELFSIGN_ENFORCE_PRNU=1
